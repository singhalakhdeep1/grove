generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  password          String
  name              String
  avatar            String?
  role              UserRole             @default(STUDENT)
  isVerified        Boolean              @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  twoFactorEnabled  Boolean              @default(false)
  twoFactorSecret   String?              // TOTP secret key
  backupCodes       String[]             // Backup codes for 2FA
  
  // Relations
  profile           UserProfile?
  enrollments       Enrollment[]
  courseCreated     Course[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  assignments       AssignmentSubmission[]
  forumThreads      ForumThread[]
  forumPosts        ForumPost[]
  votes             Vote[]
  achievements      UserAchievement[]
  badges            UserBadge[]
  points            PointTransaction[]
  studyGroups       StudyGroupMember[]
  mentorProfile     MentorProfile?
  mentorships       Mentorship[]        @relation("Mentee")
  mentoring         Mentorship[]        @relation("Mentor")
  resources         Resource[]
  bookmarks         Bookmark[]
  notes             Note[]
  friendshipsFrom   Friendship[]        @relation("UserFrom")
  friendshipsTo     Friendship[]        @relation("UserTo")
  following         Follow[]            @relation("Follower")
  followers         Follow[]            @relation("Following")
  activities        ActivityFeed[]
  comments          Comment[]
  likes             Like[]
  notifications     Notification[]
  messagesFrom      DirectMessage[]     @relation("Sender")
  messagesTo        DirectMessage[]     @relation("Receiver")
  sessions          Session[]
  courseInteractions UserCourseInteraction[]
  recommendations   CourseRecommendation[]
  videoBookmarks    VideoBookmark[]
  videoNotes        VideoNote[]
  playbackSessions  VideoPlaybackSession[]
  teamMemberships   TeamMember[]
  seasonalAchievements UserSeasonalAchievement[]
  virtualCurrency   VirtualCurrency?
  currencyTransactions CurrencyTransaction[]
  rewardPurchases   RewardPurchase[]
  subscription       UserSubscription?
  payments           Payment[]
  promoUsages        PromotionalCodeUsage[]
  invoices           Invoice[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  MENTOR
  ADMIN
}

model UserProfile {
  id                String      @id @default(uuid())
  userId            String      @unique
  bio               String?     @db.Text
  headline          String?
  location          String?
  website           String?
  linkedin          String?
  github            String?
  twitter           String?
  timezone          String?
  language          String      @default("en")
  skillLevel        SkillLevel  @default(BEGINNER)
  totalPoints       Int         @default(0)
  currentStreak     Int         @default(0)
  longestStreak     Int         @default(0)
  lastActivityDate  DateTime?
  reputationScore   Int         @default(0)
  
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_profiles")
}

enum SkillLevel {
  BEGINNER
  LEARNER
  INTERMEDIATE
  ADVANCED
  EXPERT
  MASTER
}

model Session {
  id            String   @id @default(uuid())
  userId        String
  token         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@map("sessions")
}

// ============================================
// COURSES & LEARNING
// ============================================

model Course {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  description     String            @db.Text
  thumbnail       String?
  previewVideo    String?
  level           CourseLevel
  language        String            @default("en")
  price           Float             @default(0)
  discountPrice   Float?
  duration        Int               // Total minutes
  isPublished     Boolean           @default(false)
  isFree          Boolean           @default(false)
  instructorId    String
  categoryId      String?
  prerequisites   String[]
  learningGoals   String[]
  requirements    String[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  instructor      User              @relation(fields: [instructorId], references: [id])
  category        CourseCategory?   @relation(fields: [categoryId], references: [id])
  modules         CourseModule[]
  enrollments     Enrollment[]
  reviews         CourseReview[]
  tags            CourseTag[]
  certificates    Certificate[]
  interactions    UserCourseInteraction[]
  recommendations CourseRecommendation[]
  
  @@index([slug])
  @@index([instructorId])
  @@map("courses")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
  ALL_LEVELS
}

model CourseCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  parentId    String?
  
  parent      CourseCategory?  @relation("Subcategories", fields: [parentId], references: [id])
  children    CourseCategory[] @relation("Subcategories")
  courses     Course[]
  
  @@map("course_categories")
}

model CourseModule {
  id          String    @id @default(uuid())
  courseId    String
  title       String
  description String?   @db.Text
  order       Int
  createdAt   DateTime  @default(now())
  
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  
  @@map("course_modules")
}

model Lesson {
  id          String          @id @default(uuid())
  moduleId    String
  title       String
  description String?         @db.Text
  content     String?         @db.Text
  type        LessonType
  videoUrl    String?
  videoDuration Int?          // Seconds
  attachments String[]
  order       Int
  isFree      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  
  module      CourseModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  quiz        Quiz?
  assignment  Assignment?
  bookmarks   VideoBookmark[]
  notes       VideoNote[]
  playbackSessions VideoPlaybackSession[]
  analytics   VideoAnalytics?
  
  @@map("lessons")
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
  LIVE_SESSION
  RESOURCE
}

model Enrollment {
  id                String              @id @default(uuid())
  userId            String
  courseId          String
  status            EnrollmentStatus    @default(ACTIVE)
  progress          Float               @default(0) // Percentage
  enrolledAt        DateTime            @default(now())
  completedAt       DateTime?
  lastAccessedAt    DateTime?
  
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([userId, courseId])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  EXPIRED
}

model LessonProgress {
  id              String      @id @default(uuid())
  userId          String
  lessonId        String
  isCompleted     Boolean     @default(false)
  watchTime       Int         @default(0) // Seconds
  lastPosition    Int         @default(0) // Seconds for videos
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ============================================
// QUIZZES & ASSESSMENTS
// ============================================

model Quiz {
  id              String          @id @default(uuid())
  lessonId        String          @unique
  title           String
  description     String?         @db.Text
  passingScore    Int             @default(70)
  timeLimit       Int?            // Minutes
  maxAttempts     Int?
  shuffleQuestions Boolean        @default(false)
  showAnswers     Boolean         @default(true)
  
  lesson          Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions       Question[]
  attempts        QuizAttempt[]
  
  @@map("quizzes")
}

model Question {
  id          String          @id @default(uuid())
  quizId      String
  content     String          @db.Text
  type        QuestionType
  points      Int             @default(1)
  order       Int
  explanation String?         @db.Text
  
  quiz        Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     QuestionOption[]
  answers     Answer[]
  
  @@map("questions")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  MATCHING
}

model QuestionOption {
  id          String      @id @default(uuid())
  questionId  String
  content     String      @db.Text
  isCorrect   Boolean     @default(false)
  order       Int
  
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@map("question_options")
}

model QuizAttempt {
  id          String      @id @default(uuid())
  userId      String
  quizId      String
  score       Float
  passed      Boolean
  timeSpent   Int         // Seconds
  startedAt   DateTime
  completedAt DateTime?
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     Answer[]
  
  @@map("quiz_attempts")
}

model Answer {
  id          String      @id @default(uuid())
  attemptId   String
  questionId  String
  answer      String      @db.Text
  isCorrect   Boolean?
  points      Float       @default(0)
  
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@map("answers")
}

// ============================================
// ASSIGNMENTS
// ============================================

model Assignment {
  id              String                  @id @default(uuid())
  lessonId        String                  @unique
  title           String
  description     String                  @db.Text
  instructions    String                  @db.Text
  dueDate         DateTime?
  maxPoints       Int                     @default(100)
  attachments     String[]
  
  lesson          Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions     AssignmentSubmission[]
  
  @@map("assignments")
}

model AssignmentSubmission {
  id              String          @id @default(uuid())
  assignmentId    String
  userId          String
  content         String          @db.Text
  attachments     String[]
  status          SubmissionStatus @default(SUBMITTED)
  score           Float?
  feedback        String?         @db.Text
  submittedAt     DateTime        @default(now())
  gradedAt        DateTime?
  
  assignment      Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("assignment_submissions")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

// ============================================
// REVIEWS & RATINGS
// ============================================

model CourseReview {
  id          String      @id @default(uuid())
  courseId    String
  userId      String
  rating      Int         // 1-5
  title       String?
  comment     String?     @db.Text
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([courseId, userId])
  @@map("course_reviews")
}

model Certificate {
  id          String      @id @default(uuid())
  userId      String
  courseId    String
  certificateNumber String  @unique
  issueDate   DateTime    @default(now())
  verificationUrl String?
  
  course      Course      @relation(fields: [courseId], references: [id])
  
  @@map("certificates")
}

// ============================================
// COMMUNITY FORUMS
// ============================================

model ForumCategory {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  icon        String?
  order       Int           @default(0)
  
  threads     ForumThread[]
  
  @@map("forum_categories")
}

model ForumThread {
  id          String          @id @default(uuid())
  categoryId  String
  userId      String
  title       String
  content     String          @db.Text
  isPinned    Boolean         @default(false)
  isLocked    Boolean         @default(false)
  views       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  category    ForumCategory   @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  posts       ForumPost[]
  tags        ThreadTag[]
  votes       Vote[]
  
  @@index([categoryId])
  @@map("forum_threads")
}

model ForumPost {
  id          String      @id @default(uuid())
  threadId    String
  userId      String
  content     String      @db.Text
  isBestAnswer Boolean    @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  thread      ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  votes       Vote[]
  
  @@map("forum_posts")
}

model Tag {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  
  threads     ThreadTag[]
  courses     CourseTag[]
  
  @@map("tags")
}

model ThreadTag {
  threadId    String
  tagId       String
  
  thread      ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([threadId, tagId])
  @@map("thread_tags")
}

model CourseTag {
  courseId    String
  tagId       String
  
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([courseId, tagId])
  @@map("course_tags")
}

model Vote {
  id          String       @id @default(uuid())
  userId      String
  voteType    VoteType
  threadId    String?
  postId      String?
  createdAt   DateTime     @default(now())
  
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread      ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post        ForumPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@unique([userId, threadId])
  @@unique([userId, postId])
  @@map("votes")
}

enum VoteType {
  UP
  DOWN
}

// ============================================
// LIVE SESSIONS
// ============================================

model LiveSession {
  id              String              @id @default(uuid())
  courseId        String?
  instructorId    String
  title           String
  description     String?             @db.Text
  scheduledAt     DateTime
  duration        Int                 // Minutes
  meetingUrl      String?
  recordingUrl    String?
  status          SessionStatus       @default(SCHEDULED)
  maxParticipants Int?
  
  participants    SessionParticipant[]
  chats           SessionChat[]
  
  @@map("live_sessions")
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model SessionParticipant {
  id          String      @id @default(uuid())
  sessionId   String
  userId      String
  joinedAt    DateTime?
  leftAt      DateTime?
  attended    Boolean     @default(false)
  
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@unique([sessionId, userId])
  @@map("session_participants")
}

model SessionChat {
  id          String      @id @default(uuid())
  sessionId   String
  userId      String
  message     String      @db.Text
  createdAt   DateTime    @default(now())
  
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@map("session_chats")
}

// ============================================
// GAMIFICATION
// ============================================

model Achievement {
  id          String            @id @default(uuid())
  name        String
  description String
  icon        String
  category    AchievementCategory
  points      Int               @default(0)
  requirement String            // JSON string for requirement logic
  
  users       UserAchievement[]
  
  @@map("achievements")
}

enum AchievementCategory {
  LEARNING
  COMMUNITY
  SOCIAL
  MILESTONE
  SPECIAL
}

model UserAchievement {
  id              String      @id @default(uuid())
  userId          String
  achievementId   String
  unlockedAt      DateTime    @default(now())
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement     Achievement @relation(fields: [achievementId], references: [id])
  
  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  description String
  icon        String
  level       BadgeLevel
  
  users       UserBadge[]
  
  @@map("badges")
}

enum BadgeLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model UserBadge {
  id          String      @id @default(uuid())
  userId      String
  badgeId     String
  earnedAt    DateTime    @default(now())
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge       @relation(fields: [badgeId], references: [id])
  
  @@unique([userId, badgeId])
  @@map("user_badges")
}

model PointTransaction {
  id          String              @id @default(uuid())
  userId      String
  points      Int
  type        PointTransactionType
  description String
  createdAt   DateTime            @default(now())
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("point_transactions")
}

enum PointTransactionType {
  EARNED
  SPENT
  BONUS
  PENALTY
}

model Leaderboard {
  id          String      @id @default(uuid())
  userId      String
  type        LeaderboardType
  score       Int
  rank        Int
  period      String      // e.g., "2024-01", "2024-Q1"
  
  @@unique([userId, type, period])
  @@map("leaderboards")
}

enum LeaderboardType {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

// ============================================
// STUDY GROUPS
// ============================================

model StudyGroup {
  id          String            @id @default(uuid())
  name        String
  description String?           @db.Text
  type        GroupType
  maxMembers  Int?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  
  members     StudyGroupMember[]
  discussions GroupDiscussion[]
  resources   GroupResource[]
  
  @@map("study_groups")
}

enum GroupType {
  PUBLIC
  PRIVATE
  COURSE_BASED
}

model StudyGroupMember {
  id          String      @id @default(uuid())
  groupId     String
  userId      String
  role        GroupRole   @default(MEMBER)
  joinedAt    DateTime    @default(now())
  
  group       StudyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([groupId, userId])
  @@map("study_group_members")
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model GroupDiscussion {
  id          String      @id @default(uuid())
  groupId     String
  userId      String
  title       String
  content     String      @db.Text
  createdAt   DateTime    @default(now())
  
  group       StudyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  @@map("group_discussions")
}

model GroupResource {
  id          String      @id @default(uuid())
  groupId     String
  userId      String
  title       String
  url         String
  type        String
  createdAt   DateTime    @default(now())
  
  group       StudyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  @@map("group_resources")
}

// ============================================
// MENTORSHIP
// ============================================

model MentorProfile {
  id              String      @id @default(uuid())
  userId          String      @unique
  expertise       String[]
  experience      String      @db.Text
  availability    String      // JSON string
  hourlyRate      Float?
  isActive        Boolean     @default(true)
  rating          Float       @default(0)
  totalSessions   Int         @default(0)
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorships     Mentorship[]
  
  @@map("mentor_profiles")
}

model Mentorship {
  id          String            @id @default(uuid())
  mentorId    String
  menteeId    String
  status      MentorshipStatus  @default(PENDING)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime          @default(now())
  
  mentor      User              @relation("Mentor", fields: [mentorId], references: [id])
  mentee      User              @relation("Mentee", fields: [menteeId], references: [id])
  profile     MentorProfile     @relation(fields: [mentorId], references: [id])
  sessions    MentorSession[]
  goals       MentorGoal[]
  
  @@map("mentorships")
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model MentorSession {
  id              String      @id @default(uuid())
  mentorshipId    String
  scheduledAt     DateTime
  duration        Int         // Minutes
  notes           String?     @db.Text
  feedback        String?     @db.Text
  status          SessionStatus @default(SCHEDULED)
  
  mentorship      Mentorship  @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  
  @@map("mentor_sessions")
}

model MentorGoal {
  id              String      @id @default(uuid())
  mentorshipId    String
  title           String
  description     String      @db.Text
  targetDate      DateTime?
  isCompleted     Boolean     @default(false)
  completedAt     DateTime?
  
  mentorship      Mentorship  @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  
  @@map("mentor_goals")
}

// ============================================
// CONTENT LIBRARY
// ============================================

model Resource {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String?       @db.Text
  type        ResourceType
  url         String?
  content     String?       @db.Text
  fileSize    Int?
  tags        String[]
  isPublic    Boolean       @default(false)
  downloads   Int           @default(0)
  createdAt   DateTime      @default(now())
  
  user        User          @relation(fields: [userId], references: [id])
  collections CollectionResource[]
  
  @@map("resources")
}

enum ResourceType {
  DOCUMENT
  VIDEO
  AUDIO
  CODE
  LINK
  NOTE
}

model Collection {
  id          String              @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean             @default(false)
  
  resources   CollectionResource[]
  
  @@map("collections")
}

model CollectionResource {
  collectionId String
  resourceId   String
  order        Int       @default(0)
  
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  @@id([collectionId, resourceId])
  @@map("collection_resources")
}

model Bookmark {
  id          String      @id @default(uuid())
  userId      String
  type        BookmarkType
  targetId    String
  createdAt   DateTime    @default(now())
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, type, targetId])
  @@map("bookmarks")
}

enum BookmarkType {
  COURSE
  LESSON
  THREAD
  RESOURCE
}

model Note {
  id          String      @id @default(uuid())
  userId      String
  lessonId    String?
  title       String?
  content     String      @db.Text
  isPrivate   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notes")
}

// ============================================
// SOCIAL FEATURES
// ============================================

model Friendship {
  id          String          @id @default(uuid())
  userFromId  String
  userToId    String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  
  userFrom    User            @relation("UserFrom", fields: [userFromId], references: [id], onDelete: Cascade)
  userTo      User            @relation("UserTo", fields: [userToId], references: [id], onDelete: Cascade)
  
  @@unique([userFromId, userToId])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Follow {
  id          String      @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime    @default(now())
  
  follower    User        @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User        @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  
  @@unique([followerId, followingId])
  @@map("follows")
}

model ActivityFeed {
  id          String          @id @default(uuid())
  userId      String
  type        ActivityType
  content     String          @db.Text
  targetId    String?
  targetType  String?
  isPublic    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]
  
  @@map("activity_feeds")
}

enum ActivityType {
  COURSE_COMPLETED
  LESSON_COMPLETED
  BADGE_EARNED
  ACHIEVEMENT_UNLOCKED
  POST_CREATED
  COMMENT_ADDED
  RESOURCE_SHARED
}

model Comment {
  id          String      @id @default(uuid())
  userId      String
  activityId  String
  content     String      @db.Text
  createdAt   DateTime    @default(now())
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity    ActivityFeed @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  @@map("comments")
}

model Like {
  id          String      @id @default(uuid())
  userId      String
  activityId  String
  createdAt   DateTime    @default(now())
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity    ActivityFeed @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, activityId])
  @@map("likes")
}

model DirectMessage {
  id          String      @id @default(uuid())
  senderId    String
  receiverId  String
  content     String      @db.Text
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  
  sender      User        @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User        @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  
  @@map("direct_messages")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String            @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String            @db.Text
  link        String?
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

enum NotificationType {
  COURSE_UPDATE
  NEW_LESSON
  ASSIGNMENT_DUE
  QUIZ_GRADED
  FORUM_REPLY
  MESSAGE_RECEIVED
  FRIEND_REQUEST
  ACHIEVEMENT_EARNED
  SESSION_REMINDER
  MENTOR_REQUEST
  GROUP_INVITATION
}

// ============================================
// AI RECOMMENDATIONS
// ============================================

model UserCourseInteraction {
  id          String                @id @default(uuid())
  userId      String
  courseId    String
  action      InteractionAction
  duration    Int?                  // Time spent in seconds
  rating      Int?                  // 1-5 rating
  completed   Boolean               @default(false)
  timestamp   DateTime              @default(now())
  
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@index([userId, courseId])
  @@index([userId, timestamp])
  @@map("user_course_interactions")
}

enum InteractionAction {
  VIEWED
  ENROLLED
  LESSON_STARTED
  LESSON_COMPLETED
  COURSE_COMPLETED
  RATED
  REVIEWED
  BOOKMARKED
  SHARED
}

model CourseRecommendation {
  id          String              @id @default(uuid())
  userId      String
  courseId    String
  score       Float               // Recommendation confidence score
  reason      RecommendationReason
  algorithm   RecommendationAlgorithm
  createdAt   DateTime            @default(now())
  clicked     Boolean             @default(false)
  enrolled    Boolean             @default(false)
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([userId, courseId, algorithm])
  @@index([userId, score])
  @@map("course_recommendations")
}

enum RecommendationReason {
  SIMILAR_USERS
  CONTENT_BASED
  POPULAR
  TRENDING
  CONTINUE_LEARNING
  SKILL_BUILDING
  CAREER_PATH
  SOCIAL_PROOF
}

enum RecommendationAlgorithm {
  COLLABORATIVE_FILTERING
  CONTENT_BASED
  HYBRID
  POPULARITY_BASED
  TRENDING
  DEEP_LEARNING
}

// ============================================
// REAL-TIME ANALYTICS
// ============================================

model RealTimeAnalytics {
  id          String    @id @default(uuid())
  metric      String    // 'active_users', 'enrollments', 'course_completions', etc.
  value       Float
  timestamp   DateTime  @default(now())
  metadata    String?   // JSON string for additional context
  
  @@index([metric, timestamp])
  @@map("real_time_analytics")
}

model AnalyticsEvent {
  id          String          @id @default(uuid())
  userId      String?
  eventType   EventType
  eventData   String          @db.Text  // JSON string
  sessionId   String?
  timestamp   DateTime        @default(now())
  
  @@index([eventType, timestamp])
  @@index([userId, timestamp])
  @@map("analytics_events")
}

enum EventType {
  PAGE_VIEW
  COURSE_VIEW
  LESSON_START
  LESSON_COMPLETE
  QUIZ_START
  QUIZ_COMPLETE
  ENROLLMENT
  CERTIFICATE_EARNED
  FORUM_VISIT
  LIVE_SESSION_JOIN
  MENTORSHIP_REQUEST
  SEARCH_QUERY
  FILTER_APPLY
  RECOMMENDATION_CLICK
  PAYMENT_INITIATED
  PAYMENT_COMPLETED
}

// ============================================
// INTERACTIVE VIDEO FEATURES
// ============================================

model VideoBookmark {
  id          String      @id @default(uuid())
  userId      String
  lessonId    String
  timestamp   Int         // Video timestamp in seconds
  title       String?
  description String?     @db.Text
  createdAt   DateTime    @default(now())
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([userId, lessonId, timestamp])
  @@index([userId, lessonId])
  @@map("video_bookmarks")
}

model VideoNote {
  id          String      @id @default(uuid())
  userId      String
  lessonId    String
  timestamp   Int         // Video timestamp in seconds
  content     String      @db.Text
  isPrivate   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@index([userId, lessonId])
  @@map("video_notes")
}

model VideoPlaybackSession {
  id          String      @id @default(uuid())
  userId      String
  lessonId    String
  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  totalWatchTime Int       // Total seconds watched
  completionRate Float     // 0-1 percentage of video watched
  lastPosition Int         // Last timestamp watched
  playbackSpeed Float      @default(1.0)
  quality     String?     // Video quality (1080p, 720p, etc.)
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@index([userId, lessonId])
  @@map("video_playback_sessions")
}

model VideoAnalytics {
  id          String      @id @default(uuid())
  lessonId    String
  totalViews  Int         @default(0)
  totalWatchTime Int      @default(0) // Total seconds across all views
  averageCompletionRate Float @default(0)
  averageWatchTime Int    @default(0)
  dropOffPoints String    @db.Text // JSON array of timestamps where users drop off
  heatmapData String      @db.Text // JSON array of engagement by timestamp
  updatedAt   DateTime    @updatedAt
  
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([lessonId])
  @@map("video_analytics")
}

// ============================================
// ADVANCED GAMIFICATION
// ============================================

model TeamChallenge {
  id          String              @id @default(uuid())
  name        String
  description String              @db.Text
  type        ChallengeType
  startDate   DateTime
  endDate     DateTime
  targetValue Int                 // Target value for the challenge
  rewardXP    Int                 @default(0)
  rewardBadge String?
  isActive    Boolean             @default(true)
  maxTeams    Int?
  createdAt   DateTime            @default(now())
  
  teams       ChallengeTeam[]
  progress    ChallengeProgress[]
  
  @@map("team_challenges")
}

enum ChallengeType {
  COURSE_COMPLETION
  QUIZ_SCORE
  LEARNING_STREAK
  FORUM_PARTICIPATION
  MENTORSHIP_HOURS
  STUDY_GROUP_ACTIVITY
  CERTIFICATION_EARNED
  COMBINED
}

model ChallengeTeam {
  id          String              @id @default(uuid())
  challengeId String
  name        String
  description String?             @db.Text
  maxMembers  Int
  currentXP   Int                 @default(0)
  rank        Int?
  createdAt   DateTime            @default(now())
  
  challenge   TeamChallenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  
  @@map("challenge_teams")
}

model TeamMember {
  id          String              @id @default(uuid())
  teamId      String
  userId      String
  role        TeamRole            @default(MEMBER)
  contributionXP Int              @default(0)
  joinedAt    DateTime            @default(now())
  
  team        ChallengeTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([teamId, userId])
  @@map("team_members")
}

enum TeamRole {
  CAPTAIN
  MEMBER
}

model ChallengeProgress {
  id          String              @id @default(uuid())
  challengeId String
  teamId      String
  metric      String              // e.g., 'courses_completed', 'quiz_scores'
  value       Int                 @default(0)
  updatedAt   DateTime            @updatedAt
  
  challenge   TeamChallenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team        ChallengeTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  @@unique([challengeId, teamId, metric])
  @@map("challenge_progress")
}

model SeasonalEvent {
  id          String              @id @default(uuid())
  name        String
  description String              @db.Text
  theme       String              // e.g., 'summer', 'halloween', 'new_year'
  startDate   DateTime
  endDate     DateTime
  multiplier  Float               @default(1.0) // XP multiplier
  specialRewards String[]         // JSON array of special rewards
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  
  achievements SeasonalAchievement[]
  
  @@map("seasonal_events")
}

model SeasonalAchievement {
  id          String              @id @default(uuid())
  eventId     String
  name        String
  description String              @db.Text
  requirement String             // JSON string for requirement logic
  rewardXP    Int                 @default(0)
  rewardBadge String?
  icon        String?
  isLimited   Boolean             @default(true) // Limited time only
  
  event       SeasonalEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  unlocks     UserSeasonalAchievement[]
  
  @@map("seasonal_achievements")
}

model UserSeasonalAchievement {
  id              String              @id @default(uuid())
  userId          String
  achievementId   String
  unlockedAt      DateTime            @default(now())
  
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement     SeasonalAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@map("user_seasonal_achievements")
}

model VirtualCurrency {
  id          String              @id @default(uuid())
  userId      String              @unique
  balance     Int                 @default(0)
  earnedTotal Int                 @default(0)
  spentTotal  Int                 @default(0)
  lastUpdated DateTime            @updatedAt
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CurrencyTransaction[]
  
  @@map("virtual_currency")
}

model CurrencyTransaction {
  id          String              @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Int
  description String
  metadata    String?             @db.Text // JSON string for additional context
  createdAt   DateTime            @default(now())
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency    VirtualCurrency     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("currency_transactions")
}

enum TransactionType {
  EARNED
  SPENT
  REFUNDED
  BONUS
  PENALTY
}

model RewardShop {
  id          String              @id @default(uuid())
  name        String
  description String              @db.Text
  type        RewardType
  cost        Int                 // Virtual currency cost
  image       String?
  isActive    Boolean             @default(true)
  stock       Int?                // null for unlimited
  metadata    String?             @db.Text // JSON for reward-specific data
  createdAt   DateTime            @default(now())
  
  purchases   RewardPurchase[]
  
  @@map("reward_shop")
}

enum RewardType {
  BADGE
  COURSE_DISCOUNT
  PREMIUM_ACCESS
  CUSTOM_AVATAR
  CERTIFICATE_FRAME
  MENTORSHIP_SESSION
  PHYSICAL_ITEM
}

model RewardPurchase {
  id          String              @id @default(uuid())
  userId      String
  rewardId    String
  cost        Int
  purchasedAt DateTime            @default(now())
  status      PurchaseStatus      @default(COMPLETED)
  metadata    String?             @db.Text
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      RewardShop          @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  
  @@map("reward_purchases")
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// ============================================
// SUBSCRIPTION & PAYMENT SYSTEM
// ============================================

model SubscriptionPlan {
  id          String              @id @default(uuid())
  name        String
  description String              @db.Text
  price       Float               // Monthly price
  currency    String              @default("USD")
  interval    SubscriptionInterval @default(MONTHLY)
  features    String[]            // JSON array of features
  maxCourses  Int?                // Unlimited if null
  maxMentorshipHours Int?         // Unlimited if null
  isActive    Boolean             @default(true)
  stripePriceId String?            // Stripe price ID
  createdAt   DateTime            @default(now())
  
  subscriptions UserSubscription[]
  
  @@map("subscription_plans")
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

model UserSubscription {
  id          String              @id @default(uuid())
  userId      String
  planId      String
  status      SubscriptionStatus  @default(ACTIVE)
  startDate   DateTime            @default(now())
  endDate     DateTime?
  cancelAt    DateTime?
  stripeSubscriptionId String?
  stripeCustomerId String?
  autoRenew   Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan    @relation(fields: [planId], references: [id])
  
  @@unique([userId])
  @@map("user_subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIALING
}

model Payment {
  id          String              @id @default(uuid())
  userId      String
  subscriptionId String?
  amount      Float
  currency    String              @default("USD")
  status      PaymentStatus       @default(PENDING)
  paymentMethod PaymentMethod
  stripePaymentIntentId String?
  failureReason String?
  metadata    String?             @db.Text // JSON for additional context
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription UserSubscription?  @relation(fields: [subscriptionId], references: [id])
  
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  BANK_TRANSFER
  CRYPTO
}

model PromotionalCode {
  id          String              @id @default(uuid())
  code        String              @unique
  description String?
  discountType DiscountType
  discountValue Float             // Percentage or fixed amount
  maxUses     Int?                // null for unlimited
  usedCount   Int                 @default(0)
  validFrom   DateTime
  validUntil  DateTime
  applicablePlans String[]        // IDs of applicable plans
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  
  usages      PromotionalCodeUsage[]
  
  @@map("promotional_codes")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromotionalCodeUsage {
  id          String              @id @default(uuid())
  codeId      String
  userId      String
  discountAmount Float
  usedAt      DateTime            @default(now())
  
  code        PromotionalCode     @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([codeId, userId])
  @@map("promotional_code_usages")
}

model Invoice {
  id          String              @id @default(uuid())
  userId      String
  subscriptionId String?
  paymentId   String?
  invoiceNumber String            @unique
  amount      Float
  currency    String              @default("USD")
  status      InvoiceStatus       @default(DRAFT)
  dueDate     DateTime
  paidAt      DateTime?
  items       String              @db.Text // JSON array of invoice items
  pdfUrl      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment?            @relation(fields: [paymentId], references: [id])
  
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}
